# Cấu hình Firebase để đăng nhập & đồng bộ tiến độ.
# Chép file này thành .env.local rồi điền giá trị lấy từ
# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration.
# (Các giá trị này không phải bí mật — dữ liệu được bảo vệ bằng firestore.rules.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
